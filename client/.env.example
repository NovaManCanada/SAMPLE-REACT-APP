# Copy to .env and fill in real values. Never commit the real .env file.

# Hostname (no protocol/port) used to reach the Vite dev server from other devices
# on your network — e.g. so emailed verification/reset links work when opened from
# a different device than the one running `npm run dev`. Leave unset to only allow
# localhost. Also add the matching origin to CLIENT_ORIGIN in server/.env.
VITE_DEV_HOST=claude.homelab.net
