# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# MongoDB connection string (local-only default; use a vault-backed secret in any shared/deployed environment)
MONGODB_URI=mongodb://127.0.0.1:27017/sample_auth_app

# CORS allow-list (comma-separated origins)
CLIENT_ORIGIN=http://localhost:5173

# JWT secrets - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use two DIFFERENT random secrets (access vs refresh) so compromising one doesn't compromise the other.
JWT_ACCESS_SECRET=replace-with-a-64-byte-random-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-64-byte-random-hex-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Email-verification / password-reset token TTLs (minutes)
EMAIL_VERIFICATION_TTL_MIN=1440
PASSWORD_RESET_TTL_MIN=30

# SMTP (for local dev, create a free test inbox at https://ethereal.email and paste creds here)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
EMAIL_FROM="Sample App <no-reply@example.com>"

# Account lockout policy
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_MINUTES=15

# Rate limits on auth endpoints. These defaults (20 req/15min, 5 req/hour) are the Sapiens
# production-safe values — only raise them for local development convenience, never in a
# deployed environment.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MIN=15
SENSITIVE_RATE_LIMIT_MAX=5
SENSITIVE_RATE_LIMIT_WINDOW_MIN=60
